import pandas as pd
import matplotlib.pyplot as plt

df_stock = pd.read_csv('alphabet_stock_data.csv')
df_stock['Date'] = pd.to_datetime(df_stock['Date'])
df_stock.set_index('Date', inplace=True)

stock_range = df_stock.loc['2020-01-01':'2020-12-31']

plt.figure(figsize=(10, 5))
plt.plot(stock_range.index, stock_range['Close'], color='navy', linewidth=2, label='Closing Price')
plt.title('Alphabet Inc. Stock Price (2020-01-01 to 2020-12-31)')
plt.xlabel('Date')
plt.ylabel('Price (USD)')
plt.grid(True, linestyle='--', alpha=0.6)
plt.legend()
plt.tight_layout()
plt.show()
